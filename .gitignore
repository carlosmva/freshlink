coverage/
libpeerconnection.log
testem.log
typings/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/
.history/
.DS_Store
Thumbs.db
*.swp
*~

