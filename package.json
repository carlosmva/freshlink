{
  "name": "freshlink",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start-local.cjs",
    "start:ui": "ng serve",
    "api": "node scripts/dev-api.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "netlify dev",
    "db:seed": "node scripts/seed-neon.cjs",
